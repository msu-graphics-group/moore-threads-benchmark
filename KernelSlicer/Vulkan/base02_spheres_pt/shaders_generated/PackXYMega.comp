///////////////////////////////////////////////////////////////// subkernels here
void kernel_PackXY_out_pakedXY(uint tidX, uint tidY, uint out_pakedXYOffset) 
{
  
  uint w      = uint(ubo.m_width);
  uint offset = tidX + tidY*w;
  out_pakedXY[offset + out_pakedXYOffset] = ((tidY << 16) & 0xFFFF0000) | (tidX & 0x0000FFFF);

}

///////////////////////////////////////////////////////////////// subkernels here

void main()
{
  ///////////////////////////////////////////////////////////////// prolog
  const uint tidX = uint(gl_GlobalInvocationID[0]); 
  const uint tidY = uint(gl_GlobalInvocationID[1]); 
  ///////////////////////////////////////////////////////////////// prolog
  
  kernel_PackXY_out_pakedXY(tidX, tidY, 0);

}

