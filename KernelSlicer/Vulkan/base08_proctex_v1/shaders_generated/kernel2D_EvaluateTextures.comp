layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout( push_constant ) uniform kernelArgs
{
  int a_branchMode;
  int h; 
  int w; 
  uint iNumElementsZ; 
  uint tFlagsMask;    
} kgenArgs;



void main()
{
  bool runThisThread = true;
  const int y = int(gl_GlobalInvocationID[0]); 
  const int x = int(gl_GlobalInvocationID[1]); 
  if(y >= kgenArgs.h + 0 || x >= kgenArgs.w + 0)
    runThisThread = false;
    if(runThisThread)
  {
   
      const vec2 texCoord = vec2(float(x)/float(kgenArgs.w),float(y)/float(kgenArgs.h));
      const float brickColor = CheckerSignMuFract(texCoord*16.0f);
      
      int index = ((x + y)/((kgenArgs.w*2)/ubo.m_usedImplementations)) % (ubo.m_usedImplementations); // for BRANCHING_LITE
      {
        if(kgenArgs.a_branchMode == BRANCHING_MEDIUM)
          index = ((x + y)/(128/ubo.m_usedImplementations)) % (ubo.m_usedImplementations); 
        else if(kgenArgs.a_branchMode == BRANCHING_HEAVY)
        {
          if(brickColor < 0.5f)
            index = (x + y) % ubo.m_usedImplementations;
          else
            index = ((x + y)/32) % (ubo.m_usedImplementations);
        }
      }

      const vec3 color = IProcTexture2D_Evaluate_allProcTextures(index,texCoord);
      
      outData[y*kgenArgs.w+x] = RealColorToUint32_f3(color);
    
  }
}

