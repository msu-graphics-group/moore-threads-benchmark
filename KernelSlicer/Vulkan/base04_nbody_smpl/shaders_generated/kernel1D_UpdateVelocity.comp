#version 460
#extension GL_GOOGLE_include_directive : require

#include "common_generated.h"
layout(binding = 0, set = 0) buffer data0 { BodyState m_bodies[]; }; // 
layout(binding = 1, set = 0) buffer dataUBO { nBody_Generated_UBO_Data ubo; };


//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout( push_constant ) uniform kernelArgs
{
  uint bodies_count; 
  uint iNumElementsY; 
  uint iNumElementsZ; 
  uint tFlagsMask;    
} kgenArgs;



void main()
{
  bool runThisThread = true;
  const uint i = uint(gl_GlobalInvocationID[0]); 
  if(i >= kgenArgs.bodies_count + 0)
    runThisThread = false;
    if(runThisThread)
  {
  
    vec3 acceleration = vec3(0, 0, 0);
    for (uint j = 0; j < ubo.m_bodies_size; ++j) {
//      if(m_bodies[i].pos_weight.w > MASS)
//        continue;
      if (i == j) {
        continue;
      }
      vec3 distance = xyz(m_bodies[j].pos_weight - m_bodies[i].pos_weight); // * sgn(m_bodies[i].pos_weight.w);
      float distSqr = dot(distance, distance) + SOFTENING_CONST;
      float invDistCube = 1.0f/sqrt(pow3(distSqr));
      vec3 gravitational = distance * m_bodies[j].pos_weight.w * invDistCube;

      float coeff = m_bodies[i].vel_charge.w / (4 * M_PI * PERMETTIVITY);
      vec3 electrostatic = coeff * m_bodies[j].vel_charge.w * (+1.f * distance / distSqr);

      if(MODE == 1)
      {
        acceleration += electrostatic;
      }
      else if(MODE == 0)
      {
        acceleration += gravitational;
      }
      else
        acceleration += gravitational + electrostatic;
    }
    acceleration *= dt;
    acceleration /= m_bodies[i].pos_weight.w;
    m_bodies[i].vel_charge.x += acceleration.x;
    m_bodies[i].vel_charge.y += acceleration.y;
    m_bodies[i].vel_charge.z += acceleration.z;
  
  }
}

